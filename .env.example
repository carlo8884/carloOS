# ============================================================
# CarloOS Environment Variables
# Copy to .env.local in each app directory.
# NEVER commit real values to git.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Server only, never expose

# ── Google Analytics ─────────────────────────────────────────────────────────
# Get from: analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Site Identity ─────────────────────────────────────────────────────────────
# Set per app (dog-com, vets-co, fish-com, saddle-com, lizard-com)
NEXT_PUBLIC_SITE_ID=dog-com

# ── Mailchimp ─────────────────────────────────────────────────────────────────
# Get from: mailchimp.com → Account → Extras → API Keys
MAILCHIMP_API_KEY=your-mailchimp-api-key-here
MAILCHIMP_AUDIENCE_ID=your-audience-id-here   # Audience → Settings → Audience ID
MAILCHIMP_SERVER_PREFIX=us1                   # From your Mailchimp API URL (e.g. us1, us14)

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...                 # Server only, never expose
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...               # From Stripe Dashboard → Webhooks

# ── Amazon Associates ─────────────────────────────────────────────────────────
# Tag is set in carloOS-core.js affiliate config, not as env var
# AMAZON_ASSOCIATES_TAG is embedded in affiliate link processing

# ── OpenAI (server-only) ──────────────────────────────────────────────────────
# Only required when running the SeniorPets content generation script in
# refresh mode: `npm run generate:content -- --refresh --kind condition --slug <slug>`.
# Default seed mode does not require any API key.
OPENAI_API_KEY=sk-...

# ── SeniorPets affiliate tags (server + client) ───────────────────────────────
# Replace each with the real affiliate ID from the respective program dashboard
# before going live. The seniorpets app reads NEXT_PUBLIC_*_TAG variables at
# build/runtime; defaults are placeholders for development.
NEXT_PUBLIC_AMAZON_TAG=carloOS-20
NEXT_PUBLIC_CHEWY_TAG=carloOS
NEXT_PUBLIC_CHEWY_RX_TAG=carloOS
NEXT_PUBLIC_PETWELLBEING_TAG=carloOS
NEXT_PUBLIC_NUVET_TAG=carloOS
NEXT_PUBLIC_TRUPANION_TAG=carloOS
NEXT_PUBLIC_PETSBEST_TAG=carloOS
NEXT_PUBLIC_EMBRACE_TAG=carloOS
NEXT_PUBLIC_SPOT_TAG=carloOS
NEXT_PUBLIC_PUMPKIN_TAG=carloOS

# ── SeniorPets reviewer surfacing ──────────────────────────────────────────────
# When `true`, the "Reviewed by" line shows the placeholder reviewer name on
# every condition + medication page. Leave unset for any deployment that does
# not yet have a verified DVM reviewer attached to content (QC §1.1).
# NEXT_PUBLIC_SHOW_REVIEWER=true

# ── Admin Dashboard (dog.com/admin) ──────────────────────────────────────────
# Simple password for the /admin analytics dashboard.
# Keep this secret — don't commit the real value.
NEXT_PUBLIC_ADMIN_PASSWORD_HINT=your-admin-password-here
