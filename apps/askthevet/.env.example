# ─── AskTheVet.com environment ─────────────────────────────────────────
# Copy this file to .env.local and fill in real values.

# OpenAI — server-only. Required for live AI triage; missing key falls back to a
# deterministic mock response so the UI still works end-to-end.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase — shared across all CarloOS apps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mailchimp — for /api/subscribe (EmailCapture). Optional; no-ops cleanly if absent.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature flag for EmailCapture component (gated by @carloOS/ui)
NEXT_PUBLIC_EMAIL_CAPTURE_ENABLED=true
