# ── HardMoneyLoans.com env ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_ID=hardmoneyloans

# Display-only floor — used in copy ("Leads worth $200+ each"). NEVER expose
# the actual selling price.
NEXT_PUBLIC_HARDMONEY_LEAD_PRICE_FLOOR=200

# ── Supabase (shared with other CarloOS apps) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mailchimp ──────────────────────────────────────────────────────────────
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=us21

# Newsletter for hard money market updates
NEXT_PUBLIC_EMAIL_CAPTURE_ENABLED=false

# ── Analytics ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Skimlinks (sitewide footer fallback affiliate network) ─────────────────
NEXT_PUBLIC_SKIMLINKS_ID=

# ── Google AdSense ─────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# ── Affiliate referral IDs (server-only, optional) ─────────────────────────
# Replace placeholders once lender programs are activated.
AFF_KIAVI_TAG=
AFF_RCN_TAG=
AFF_LIMAONE_TAG=
AFF_ANCHOR_TAG=
AFF_GROUNDFLOOR_TAG=
AFF_CROSSCOUNTRY_TAG=
AFF_JETLENDING_TAG=
AFF_CIVIC_TAG=
