# ─── DogPicture.com env vars ──────────────────────────────────────────
# Server-side only. Never expose AI / Stripe / Printify keys to the client.

# ── OpenAI ─────────────────────────────────────────────────────────────
# Used for image generation in /api/generate. Prefer `gpt-image-1`; falls
# back to `dall-e-3` automatically if the first call returns a 404 model error.
OPENAI_API_KEY=sk-...

# ── Stripe ────────────────────────────────────────────────────────────
# Test mode keys for dev. Webhook secret is the `whsec_` value Stripe
# prints when you run `stripe listen --forward-to localhost:3010/api/webhook/stripe`.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Public site URL used in Stripe Checkout success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# ── Printify (print-on-demand fulfillment) ────────────────────────────
# Get from https://printify.com/app/account/api — Shop ID is the integer for
# the shop you publish to (Etsy / standalone storefront / etc.).
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# ── Supabase (image storage + portrait_orders table) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket where uploaded photos and generated portraits land.
SUPABASE_STORAGE_BUCKET=dogpicture

# ── Mailchimp (weekly inspiration list) ──────────────────────────────
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=us1
# Tag applied to every signup that came through the dogpicture footer form.
MAILCHIMP_DOGPICTURE_TAG=dogpicture:weekly

# ── Email delivery for digital downloads (optional — falls back to console) ─
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@dogpicture.com

# ── Feature flags ────────────────────────────────────────────────────
# Set to "true" to call the real OpenAI/Printify APIs. When unset or "false"
# the app runs in mock mode: generation returns a placeholder image and
# Printify orders return a dummy ID. Stripe still uses your real test keys.
DOGPICTURE_LIVE_MODE=false
NEXT_PUBLIC_EMAIL_CAPTURE_ENABLED=false
