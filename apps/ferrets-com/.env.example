# Ferrets.com — environment variables (placeholders)

# Site identifier (read by next.config.mjs at build time)
NEXT_PUBLIC_SITE_ID=ferrets-com

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mailchimp (per-site audience)
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Stripe (memberships — not yet wired)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase (search/analytics — not yet wired)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
